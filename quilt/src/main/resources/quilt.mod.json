{
  "schema_version": 1,
  "quilt_loader": {
    "group": "${group}",
    "id": "cocoainput",
    "version": "${version}",
    "metadata": {
      "name": "Cocoainput",
      "description": "Support IME - Input Method Editor(Japanese,Chinese,Korean) in Minecraft on Multi-platforms(macOS, Windows, X11).",
      "contributors": {
        "Axeryok": "Author"
      },
      "icon": "assets/cocoainput/icon.png"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "init": [
        "jp.axer.cocoainput.quilt.CocoaInputQuilt"
      ]
    },
    "depends": [
      {
        "id": "quilt_loader",
        "version": "*"
      },
      {
        "id": "quilt_base",
        "version": "*"
      },
      {
        "id": "minecraft",
        "version": ">=1.21"
      }
    ]
  },
  "mixin": [
    "cocoainput.mixins.json"
  ]
}
